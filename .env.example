# ============================================================================
# JaraPlug — environment configuration
# Copy the SERVER section to  server/.env  and the CLIENT section to  client/.env
# Never commit real values. All secrets below are placeholders.
# ============================================================================

# ───────────────────────────── SERVER (server/.env) ─────────────────────────
NODE_ENV=development
PORT=4000

# Public URL of this API (used to build signed media URLs)
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (CORS + Socket.IO)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Database (managed PostgreSQL in production) ----
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jaraplug?schema=public
# Used only by the automated test-suite. The suite TRUNCATES this database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jaraplug_test?schema=public

# ---- Authentication ----
# "clerk" = Clerk (production).  "dev" = local-only passwordless dev login (refused when NODE_ENV=production).
AUTH_MODE=dev
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Secret used to sign dev-mode session tokens (dev only)
DEV_AUTH_SECRET=change-me-dev-only-secret-at-least-32-chars

# ---- Media storage ----
# "local" = private folder on the API host (dev).  "s3" = S3-compatible private bucket (production).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# HMAC secret for short-lived signed media URLs (local driver)
MEDIA_SIGNING_SECRET=change-me-media-signing-secret-at-least-32-chars
MEDIA_URL_TTL_SECONDS=900
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_IMAGE_MB=10
MAX_VIDEO_MB=500

# ---- Payments ----
# Paystack (the only payment method; buyers top up in-app credits with it).
# Use sk_test_... locally and sk_live_... in production (the production check requires a live key).
# Dashboard → Settings → API Keys & Webhooks. Set the webhook URL there to  <API_BASE_URL>/api/webhooks/payments
# Paystack signs webhooks with this same secret key, so there is no separate webhook secret.
# Test cards: https://paystack.com/docs/payments/test-payments/
PAYSTACK_SECRET_KEY=
# One in-app credit costs this many kobo (10000 = ₦100, so ₦1,000 = 10 credits). Content prices are whole numbers of credits.
CREDIT_PRICE_KOBO=10000
PLATFORM_COMMISSION_BPS=2000
PAYOUT_HOLD_DAYS=0
MIN_PAYOUT_KOBO=100000

# ---- Age / identity verification ----
# TESTING ONLY: "true" auto-approves age/identity verification for everyone. The API refuses to start with it in production.
DEMO_AUTO_VERIFY=false

# ───────────────────────────── CLIENT (client/.env) ─────────────────────────
# VITE_API_BASE_URL=http://localhost:4000
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME     # leave empty to use dev auth
